# Kavach settings. Copy to backend/.env and adjust; never commit .env.
# Every setting can also be an environment variable (Render sets them in render.yaml).
# Lines starting with # are optional: the default in brackets applies.

# --- Basics ---------------------------------------------------------------------------------------------
CC_ENV=development
# SQLite for local use (a relative path means backend/). Production: postgresql://USER:PASSWORD@HOST:5432/DBNAME
CC_DATABASE_URL=sqlite:///./consent_court.db
# true whenever the site is served over HTTPS (always in production)
CC_COOKIE_SECURE=false
# Origins allowed to call the API from another address (only the Vite dev server needs it)
CC_CORS_ORIGINS=http://localhost:5173

# --- Sign-in and security -------------------------------------------------------------------------------
CC_SESSION_TTL_MINUTES=60
CC_STEP_UP_TTL_MINUTES=5
CC_RATE_LIMIT_AUTH_PER_MINUTE=10
CC_PASSWORD_MIN_LENGTH=12

# --- AI agent permissions (Guardian) -------------------------------------------------------------------
CC_TOKEN_DEFAULT_TTL_SECONDS=300
CC_TOKEN_MAX_TTL_SECONDS=3600
CC_TOKEN_MAX_USES_LIMIT=100
CC_APPROVAL_TTL_MINUTES=15

# --- Fetching real policies -----------------------------------------------------------------------------
# A real contact (email or URL) for site owners; on Render the site's own URL is used when unset
# CC_FETCH_CONTACT=you@example.com
# Minutes a fetched policy is reused before fetching again [360]
# CC_FETCH_CACHE_MINUTES=360
# Headless Chromium for JavaScript-only pages, if installed (requirements-optional.txt) [true]
# CC_FETCH_RENDER_ENABLED=true

# --- Watchman (automatic re-checks) ---------------------------------------------------------------------
# Re-check tracked policies while the server runs [true], every N minutes [360]
# CC_WATCH_SCHEDULER_ENABLED=true
# CC_WATCH_INTERVAL_MINUTES=360
# Run the scheduled check on Render Workflows instead (see README "Scaling Watchman")
# CC_WATCHMAN_WORKFLOW=kavach-watchman-flow/check_all
# RENDER_API_KEY=
# Policies checked at the same time by the workflow [20]
# CC_WATCHMAN_PARALLEL=20

# --- Email alerts (optional) ----------------------------------------------------------------------------
# Domain of personal forwarding addresses, and the secret the email provider's webhook must send (empty = off)
CC_INBOUND_DOMAIN=inbox.kavach.local
# CC_INBOUND_SECRET=
# A Kavach-owned mailbox read on the Watchman schedule (Gmail: imap.gmail.com and an app password)
# CC_IMAP_HOST=
# CC_IMAP_USER=
# CC_IMAP_PASSWORD=

# --- Tests ----------------------------------------------------------------------------------------------
# Where pytest runs are recorded [backend/test-history]; KAVACH_NO_TEST_HISTORY=1 turns recording off
# CC_TEST_HISTORY_DIR=
# KAVACH_NO_TEST_HISTORY=1

# Test account used for browser checks on the developers' own local database (localhost only, not a real person).
# A fresh install has no accounts: create one on the sign-in page.
# tester@kavach.test / kv-FIF5K61SQIk_ihYT
