# Copy to .env and adjust. Never commit .env.
CC_ENV=development
# Local dev: SQLite. Production (Render): postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
CC_DATABASE_URL=sqlite:///./consent_court.db

CC_SESSION_TTL_MINUTES=60
CC_STEP_UP_TTL_MINUTES=5
# Set true whenever the site is served over HTTPS (always in production).
CC_COOKIE_SECURE=false

CC_TOKEN_DEFAULT_TTL_SECONDS=300
CC_TOKEN_MAX_TTL_SECONDS=3600
CC_TOKEN_MAX_USES_LIMIT=100
CC_APPROVAL_TTL_MINUTES=15

CC_RATE_LIMIT_AUTH_PER_MINUTE=10
CC_PASSWORD_MIN_LENGTH=12
CC_CORS_ORIGINS=http://localhost:5173

# Policy fetching: put a real contact (email or URL) so site owners can reach you about the bot.
CC_FETCH_CONTACT=
# Email alerts webhook (empty = off) and the domain of forwarding addresses.
CC_INBOUND_SECRET=
CC_INBOUND_DOMAIN=inbox.kavach.local
# Optional Kavach-owned monitoring mailbox for python -m app.inbox.mailbox
CC_IMAP_HOST=
CC_IMAP_USER=
CC_IMAP_PASSWORD=

# Local test account used for browser checks (localhost only, not a real person):
